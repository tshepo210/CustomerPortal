@model IEnumerable<CustomerPortal.Models.Payment>

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-primary text-white rounded-top-4 d-flex justify-content-between align-items-center">
            <h4 class="mb-0">📊 My Payments</h4>

            @if (User.IsInRole("Admin"))
            {
                <button id="btnOpenSubmitModalHeader" type="button" class="btn btn-success btn-sm">
                    Submit to SWIFT
                </button>
            }
        </div>

        <div class="card-body">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <form id="paymentsForm" asp-action="SubmitToSwift" method="post">
                @Html.AntiForgeryToken()

                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            @if (User.IsInRole("Admin"))
                            {
                                <th style="width:40px">
                                    <input id="selectAll" type="checkbox" />
                                </th>
                            }
                            <th>Amount</th>
                            <th>Currency</th>
                            <th>Account</th>
                            <th>SWIFT</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th>User</th>
                            }
                            <th>Status</th>
                            <th>Date</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                @if (User.IsInRole("Admin"))
                                {
                                    <td>
                                        <input name="selectedIds" value="@item.Id" type="checkbox" class="selectItem"
                                               @(item.IsSubmitted ? "disabled" : (!item.IsVerified ? "disabled" : "")) />
                                    </td>
                                }
                                <td><strong>@item.Amount.ToString("C")</strong></td>
                                <td>@item.Currency</td>
                                <td>@item.AccountNumber</td>
                                <td class="text-uppercase">@item.SwiftCode</td>

                                @if (User.IsInRole("Admin"))
                                {
                                    <td>@item.User?.Email</td>
                                }

                                <td>
                                    @if (item.IsSubmitted)
                                    {
                                        <span class="badge bg-success">Submitted</span>
                                        <div class="small text-muted">@item.SwiftReference</div>
                                    }
                                    else if (item.IsVerified)
                                    {
                                        <span class="badge bg-info text-dark">Verified</span>
                                        <div class="small text-muted">By @item.VerifiedBy?.Email on @item.VerifiedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>

                                <td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>

                                @if (User.IsInRole("Admin"))
                                {
                                    <td>
                                        @if (!item.IsVerified && !item.IsSubmitted)
                                        {
                                            <form asp-action="Verify" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Mark Verified</button>
                                            </form>
                                        }
                                        else if (item.IsVerified && !item.IsSubmitted)
                                        {
                                            <span class="text-success small">Ready</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>

                @if (User.IsInRole("Admin"))
                {
                    <div class="d-flex justify-content-end">
                        <button id="btnOpenSubmitModal" type="button" class="btn btn-success">Submit Selected to SWIFT</button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmSubmitModal" tabindex="-1" aria-labelledby="confirmSubmitModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmSubmitModalLabel">Confirm submission to SWIFT</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="confirmModalBody">Are you sure you want to submit <strong id="selectedCount">0</strong> payment(s) to SWIFT?</p>
                <div class="alert alert-warning d-none" id="confirmWarning">
                    Some selected payments are not verified or already submitted. Only verified, unsubmitted payments will be submitted.
                </div>
                <div class="small text-muted">
                    This operation will mark selected payments as submitted and set a SWIFT reference. This action cannot be undone from the UI.
                </div>
            </div>
            <div class="modal-footer">
                <button id="modalCancel" type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="modalConfirm" type="button" class="btn btn-primary">Confirm and Submit</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Select all toggle
        document.getElementById('selectAll')?.addEventListener('change', function (e) {
            const checked = e.target.checked;
            document.querySelectorAll('.selectItem').forEach(cb => {
                if (!cb.disabled) cb.checked = checked;
            });
        });

        // Helper: count selected valid checkboxes
        function getSelectedValidItems() {
            const items = Array.from(document.querySelectorAll('.selectItem'));
            // Only include those that are enabled (i.e., verified and not submitted)
            return items.filter(cb => !cb.disabled && cb.checked);
        }

        // Open modal handlers (header and bottom)
        const openButtons = [document.getElementById('btnOpenSubmitModal'), document.getElementById('btnOpenSubmitModalHeader')];
        openButtons.forEach(btn => {
            if (!btn) return;
            btn.addEventListener('click', function (e) {
                const selected = getSelectedValidItems();
                if (selected.length === 0) {
                    // Briefly show an inline alert instead of modal
                    alert('No verified payments selected for submission.');
                    return;
                }

                // Update modal content
                document.getElementById('selectedCount').textContent = selected.length;

                // If any selected checkboxes are not verified or are disabled (shouldn't happen) show warning
                const warning = document.getElementById('confirmWarning');
                warning.classList.add('d-none');

                // Show modal
                const modalEl = document.getElementById('confirmSubmitModal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            });
        });

        // On confirm, submit the main form
        document.getElementById('modalConfirm')?.addEventListener('click', function () {
            // Submit the form - the selected checkboxes are inside the form
            document.getElementById('paymentsForm').submit();
        });
    </script>
}